# ===========================================
# ReImage Rust Configuration
# ===========================================
# Copy this file to .env and adjust values as needed

# --- SERVER ---
PORT=80                            # Server port
CONNECTION_TIMEOUT=5000            # Connection timeout (ms)
BODY_LIMIT=1024                    # Request body limit (bytes)
REQUEST_TIMEOUT_MS=30000           # Total request timeout (ms)

# --- SECURITY / LIMITS ---
MAX_URL_LENGTH=2048                # Max URL length
MAX_TEXT_LENGTH=500                # Max text overlay length
MAX_OVERLAYS=10                    # Max number of overlays
MAX_TEXTS=10                       # Max number of text overlays
MAX_DIMENSION=8000                 # Max image dimension (px)
MIN_DIMENSION=1                    # Min image dimension (px)
MAX_RADIUS=4000                    # Max corner radius (px)

# --- HTTP AGENT ---
# NOTE: Higher defaults for high-latency scenarios (e.g., cross-region)
AGENT_CONNECT_TIMEOUT=10000        # Connect timeout (ms)
AGENT_HEADERS_TIMEOUT=10000        # Headers timeout (ms)
AGENT_BODY_TIMEOUT=30000           # Body download timeout (ms)
AGENT_CONNECTIONS=128              # Connections per origin
AGENT_PIPELINING=10                # HTTP pipelining factor
AGENT_KEEPALIVE_TIMEOUT=30000      # Keep-alive timeout (ms)
AGENT_KEEPALIVE_MAX_TIMEOUT=60000  # Max keep-alive timeout (ms)
AGENT_REJECT_UNAUTHORIZED=false    # Reject invalid SSL certs

# --- FETCH TIMEOUTS ---
# NOTE: Higher defaults for high-latency scenarios (e.g., cross-region)
FETCH_TIMEOUT_MAIN=15000           # Main image fetch timeout (ms)
FETCH_TIMEOUT_OVERLAY=10000        # Overlay fetch timeout (ms)

# --- RETRY CONFIGURATION ---
# Retry logic for transient network errors (timeouts, connection resets, etc.)
FETCH_MAX_RETRIES=3                # Max retry attempts (0 = no retries)
FETCH_RETRY_DELAY_MS=500           # Initial delay between retries (ms)
FETCH_RETRY_BACKOFF_MULTIPLIER=1.5 # Exponential backoff multiplier

# --- DNS CONFIGURATION ---
DNS_CACHE_TTL_MS=300000            # DNS cache TTL (5 min)
DNS_LOOKUP_TIMEOUT_MS=5000         # DNS lookup timeout (ms)

# --- DOWNLOAD ---
MAX_DOWNLOAD_SIZE_MB=10            # Max download size per image (MB)

# --- CACHE ---
OUTPUT_CACHE_SIZE_MB=750           # Output cache size (MB)
OUTPUT_CACHE_TTL_SEC=600           # Output cache TTL (10 min)
SOURCE_CACHE_SIZE_MB=500           # Source image cache size (MB)
OVERLAY_CACHE_MAX=200              # Max overlay cache items
OVERLAY_CACHE_TTL_SEC=1800         # Overlay cache TTL (30 min)
MASK_CACHE_MAX=500                 # Max mask cache items
MASK_CACHE_TTL_SEC=3600            # Mask cache TTL (1 hr)

# --- OUTPUT ---
WEBP_QUALITY=80                    # WebP quality (0-100)
WEBP_EFFORT=0                      # WebP encoding effort (0-6, lower=faster)

# --- LOGGING ---
# NODE_ENV=production              # Set to "production" for JSON logging
# RUST_LOG=info                    # Log level (trace, debug, info, warn, error)
